# Backend Environment Configuration
PROJECT_NAME="Store Finder API"
VERSION="1.0.0"

# Database:
# For local SQLite zero-config mode:
DATABASE_URL=sqlite+aiosqlite:///./store_finder.db
# For PostgreSQL mode:
# DATABASE_URL=postgresql+asyncpg://postgres:password123@127.0.0.1:5432/store_finder

# Meilisearch:
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=masterKey
MEILISEARCH_INDEX_NAME=stores_index

# Security:
ADMIN_API_KEY=admin123456

# CORS:
BACKEND_CORS_ORIGINS=["http://127.0.0.1:5199","http://localhost:5199","*"]
